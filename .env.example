# WebsiteCMS Environment Configuration
# Copy this file to .env and update values as needed

# Database
DATABASE_URL=sqlite:///data/site.db

# Server
PORT=8002
DEBUG=false
LOG_LEVEL=INFO

# Security (generate a secure random key for production)
SECRET_KEY=change-me-in-production

# Session
SESSION_TIMEOUT_SECONDS=86400

# =============================================================================
# SMTP Email Configuration
# =============================================================================
# Set these to enable contact form email notifications

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true
SMTP_TLS=false
CONTACT_TO_EMAIL=

# =============================================================================
# SMS Configuration (Twilio) - Optional
# =============================================================================

SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_RECIPIENT_NUMBER=

# =============================================================================
# CAPTCHA Configuration (Cloudflare Turnstile) - Optional
# =============================================================================

CAPTCHA_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# =============================================================================
# Analytics Configuration (Plausible) - Optional
# =============================================================================

ANALYTICS_ENABLED=false
PLAUSIBLE_DOMAIN=zumgugger.ch
PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/script.js
